{
  "buildCommand": "bun run vercel-build",
  "devCommand": "bun run dev",
  "installCommand": "bun install",
  "framework": "custom",
  "env": {
    "SUPABASE_URL": {
      "description": "Your Supabase project URL"
    },
    "SUPABASE_SERVICE_ROLE_KEY": {
      "description": "Your Supabase service role key (from Settings > API)"
    },
    "RESEND_API_KEY": {
      "description": "Your Resend API key for sending emails"
    }
  },
  "regions": ["sfo1"],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/api/ssr/$1" }
  ]
}
